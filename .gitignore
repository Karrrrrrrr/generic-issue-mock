# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
logs/

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a

# OS General
Thumbs.db
.DS_Store

# project
*.pb.go
*.pb.validate.go
*.cert
*.key
*.log
openapi.yaml
bin/
bin
# Develop tools
.vscode/

*.swp
__debug_bin*

# Local binaries built by `go build ./cmd/server`
/app/new/*/service/cmd/server/server
/app/new/*/interface/cmd/server/server


vendor

#idea
.idea/
*.iml


# config
configs/config-*.yaml
*.p12

*_gen.go

# gen code 生成的代码不上传
gen/*
app/new/**/gen

